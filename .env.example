# Postgres connection (psycopg 3 driver)
FERRY_DATABASE_URL=postgresql+psycopg://ferry:ferry@localhost:5433/ferry
# Required to create applications (POST /v1/apps). Use 32+ random characters.
FERRY_ADMIN_TOKEN=change-me-to-a-long-random-string
# Only for local development and tests: allow endpoints on localhost/private networks.
FERRY_ALLOW_PRIVATE_TARGETS=false
# Retry policy
FERRY_MAX_ATTEMPTS=8
FERRY_RETRY_BASE_SECONDS=5
FERRY_RETRY_MAX_SECONDS=3600
